# Copy to .env (docker compose reads it automatically) or set these as stack
# environment variables in Portainer.

# Host port the dashboard is exposed on (container port stays 8080).
HEALTHSYNC_PORT=8080

# Container timezone for logs.
TZ=Europe/Lisbon

# Optional: URL agents on your network should use (defaults to the request host).
# HEALTHSYNC_PUBLIC_URL=http://10.0.0.14:1000
